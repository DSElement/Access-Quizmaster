{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "ChatModel": "gemini-3-flash-preview",
    "EmbeddingModel": "gemini-embedding-2"
  },
  "Documents": {
    "StoragePath": "App_Data/documents",
    "ChunkSize": 1500,
    "ChunkOverlap": 200,
    "MaxChunks": 200,
    "AdminMaxChunks": 400
  },
  "QuizGeneration": {
    "TimeoutSeconds": 300,
    "ReasoningEffort": "Low",
    "PermitsPerUser": 5,
    "WindowMinutes": 10
  }
}
