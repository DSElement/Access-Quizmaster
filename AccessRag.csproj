<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AccessRag</AssemblyName>
    <RootNamespace>AccessRag</RootNamespace>
    <NoWarn>$(NoWarn);MEAI001;OPENAI001;SKEXP0001;SKEXP0020</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI"        Version="1.3.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.3.0" />
    <PackageReference Include="OpenAI"                                       Version="2.10.0" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.7.0" />
    <PackageReference Include="CommunityToolkit.VectorData.Qdrant"           Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="backend\**;frontend\**;tests\**;.cache\**" />
    <None Remove="backend\**;frontend\**;tests\**;.cache\**" />
    <Content Include="Docs\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
